{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    { "path": "/api/cron-report", "schedule": "0 4 * * *" }
  ],
  "rewrites": [
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/terms.html", "destination": "/terms.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/privacy.html", "destination": "/privacy.html" },
    { "source": "/risk-disclosure", "destination": "/risk-disclosure.html" },
    { "source": "/risk-disclosure.html", "destination": "/risk-disclosure.html" },
    { "source": "/cookies", "destination": "/cookies.html" },
    { "source": "/cookies.html", "destination": "/cookies.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",             "value": "nosniff" },
        { "key": "X-Frame-Options",                   "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection",                  "value": "1; mode=block" },
        { "key": "Referrer-Policy",                   "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",                "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security",         "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" },
        { "key": "Content-Security-Policy",           "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://cdnjs.cloudflare.com https://s3.tradingview.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; img-src 'self' data: https://s3.tradingview.com https://www.tradingview.com https://static.tradingview.com; frame-src https://www.tradingview.com https://s3.tradingview.com; connect-src 'self' https://fdwezkdtmvlcpfnbrjzp.supabase.co https://api.tradingview.com https://api.exchangerate-api.com https://api.coingecko.com https://api.exchangerate.host https://api.trongrid.io https://api.travelpayouts.com wss://data.tradingview.com wss://widgetdata.tradingview.com; worker-src blob:; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests;" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control",          "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/crypto-payment.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
